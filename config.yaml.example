# RescueNet Emergency Response Agent (RERA) Configuration
# =====================================================
# Copy this file to config.yaml and fill in your values.
# config.yaml is gitignored — never commit your real API key.

# ── LLM ─────────────────────────────────────────────
llm:
  provider: deepseek
  api_key: "YOUR_DEEPSEEK_API_KEY"       # ← Get yours at https://platform.deepseek.com/
  model: deepseek-chat
  base_url: https://api.deepseek.com/v1
  fallback:
    provider: qwen_local
    model_path: ./models/qwen2.5-7b-instruct

# ── ReAct Loop ──────────────────────────────────────
react:
  max_iterations: 10     # safety limit, prevent infinite loop
  temperature: 0.7
  max_tokens: 500

# 多模态综合分析复用上方 LLM，所配置的模型和兼容服务必须支持图片输入。
multimodal:
  max_tokens: 4096       # 综合正文使用独立预算，避免沿用短调度输出上限
  temperature: 0.3
  timeout: 180           # 单次请求超时，单位为秒
  image_detail: auto     # 图片细节级别：auto | low | high，默认由模型选择
  max_image_side: 1536   # 仅限制传输图片长边，保持宽高比；0 表示发送原尺寸
  max_attempts: 2        # JSON 结构不完整时最多尝试次数，硬上限为两次

# ── Ensemble Segmentation ───────────────────────────
ensemble:
  models:
    - unet
    - pspnet
    - deeplabv3
  confidence_lambda: 0.3   # entropy penalty weight
  weight_dir: ./runs

# ── Rescue Priority Weights ─────────────────────────
priority_weights:
  destroyed: 0.6           # Class 5 – 完全毁坏
  major: 0.3               # Class 4 – 严重损坏
  minor: 0.1               # Class 3 – 轻微损坏
  road_blocked: 0.2        # Class 8 – 道路阻塞

# ── Report Generation ───────────────────────────────
report:
  format: html             # html | markdown
  include_visualization: true
  top_k_priority_zones: 5
  output_dir: ./output/reports

# ── Agent Runtime ───────────────────────────────────
agent:
  device: auto             # auto | cuda | cpu
  batch_size: 1
